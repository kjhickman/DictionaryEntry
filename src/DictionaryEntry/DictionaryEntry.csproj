<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net9.0;net10.0;net11.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsAotCompatible>true</IsAotCompatible>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <LangVersion>latest</LangVersion>

        <PackageId>DictionaryEntry</PackageId>
        <Version>0.3.0</Version>
        <PackageVersion>0.3.0</PackageVersion>
        <Authors>Kyle Hickman</Authors>
        <Description>Dictionary manipulation with a fluent, expressive syntax.</Description>
        <PackageTags>dictionary;collections;entry;fluent;extension;union;span;aot</PackageTags>
        <Copyright>Copyright © Kyle Hickman</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/kjhickman/DictionaryEntry</PackageProjectUrl>
        <RepositoryUrl>https://github.com/kjhickman/DictionaryEntry.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <OutputType>Library</OutputType>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <IncludeSymbols>true</IncludeSymbols>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../../README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
