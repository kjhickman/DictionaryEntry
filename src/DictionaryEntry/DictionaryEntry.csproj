<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net9.0;net10.0;net11.0</TargetFrameworks>
        <IsAotCompatible>true</IsAotCompatible>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EnablePackageValidation>true</EnablePackageValidation>

        <Version>0.4.0</Version>
        <Authors>Kyle Hickman</Authors>
        <Description>Rust-inspired single-lookup Dictionary.Entry(key) API for C# with zero-allocation ReadOnlySpan&lt;char&gt; lookups, C# 15 [Union] pattern matching, and NativeAOT support.</Description>
        <PackageTags>dictionary;collections;entry;fluent;extension;union;span;aot</PackageTags>
        <Copyright>Copyright (c) 2025-2026 Kyle Hickman</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/kjhickman/DictionaryEntry</PackageProjectUrl>
        <RepositoryUrl>https://github.com/kjhickman/DictionaryEntry.git</RepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <IncludeSymbols>true</IncludeSymbols>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../../README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
