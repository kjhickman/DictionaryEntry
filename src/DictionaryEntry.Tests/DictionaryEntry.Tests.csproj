<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFrameworks>net9.0;net10.0;net11.0</TargetFrameworks>
        <UseMicrosoftTestingPlatformRunner Condition="'$(PublishAot)' != 'true'">true</UseMicrosoftTestingPlatformRunner>
    </PropertyGroup>

    <PropertyGroup Condition="'$(PublishAot)' == 'true'">
        <DefineConstants>$(DefineConstants);NATIVEAOT</DefineConstants>
        <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
        <NoWarn>$(NoWarn);IL2104;IL3053</NoWarn>
    </PropertyGroup>

    <ItemGroup Condition="'$(PublishAot)' == 'true'">
        <TrimmerRootAssembly Include="DictionaryEntry.Tests" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="DictionaryEntry.Tests.TestHelpers" />
        <Using Include="Xunit" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DictionaryEntry\DictionaryEntry.csproj" />
    </ItemGroup>

</Project>
